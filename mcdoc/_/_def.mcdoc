
use super::super::def::Uuid

struct VariableRegister {
    [string]: any
}
dispatch minecraft:storage[delay-prt:_] to struct {
    /// top level
    t: VariableRegister,
    /// impl
    v: VariableRegister,
    /// util
    u: VariableRegister,
    /// abstract
    a: VariableRegister,
    /// in-scope temp
    x: VariableRegister,
    // data
    data: struct PrivateData {
        just_left: [Uuid]
    },
    // constants
    const: struct Constants {
        
    },
    // for reentrant functions
    eval: [struct {
        in: any,
        out: any,
        v: VariableRegister,
    }]
}
dispatch minecraft:storage[delay-prt:_/in] to struct {
    [any]: any
}
dispatch minecraft:storage[delay-prt:_/out] to struct {
    [any]: any
}